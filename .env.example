# Set these in Vercel Project Settings -> Environment Variables.
# Never commit real values or service-account JSON.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"replace_me"}
# Shipping quote adapter must accept POST JSON {destination, items, subtotalInr}
# and return JSON {amountInr, quoteId?}. Configure a real shipping provider adapter.
SHIPPING_RATE_API_URL=https://your-shipping-adapter.example/api/quote
SHIPPING_RATE_API_TOKEN=replace_me
# Optional, set to the exact deployed storefront origin, e.g. https://ribbon-rain.vercel.app
ALLOWED_ORIGIN=https://your-storefront.example